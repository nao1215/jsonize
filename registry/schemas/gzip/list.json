{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/gzip/list.json",
  "title": "gzip/list",
  "description": "gzip -l compressed and uncompressed sizes",
  "x-jsonize": {
    "definition": "gzip/list",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "compressed": {
        "type": "integer"
      },
      "uncompressed": {
        "type": "integer"
      },
      "ratio": {
        "type": "string"
      },
      "uncompressed_name": {
        "type": "string"
      }
    },
    "required": [
      "compressed",
      "uncompressed",
      "ratio",
      "uncompressed_name"
    ]
  }
}
