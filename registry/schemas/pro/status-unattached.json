{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/pro/status-unattached.json",
  "title": "pro/status-unattached",
  "description": "pro status on an unattached machine, the Ubuntu Pro services it could use",
  "x-jsonize": {
    "definition": "pro/status-unattached",
    "version": 1
  },
  "type": "object",
  "properties": {
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "notice": {
            "type": "string"
          }
        },
        "required": [
          "notice"
        ]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ]
      }
    }
  },
  "required": [
    "services",
    "notices",
    "features"
  ]
}
