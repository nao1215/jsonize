            },
            "owner": {
              "type": "string"
            },
            "group": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "link_to": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
