    "required": [
      "major",
      "minor",
      "device",
      "reads_completed",
      "reads_merged",
      "sectors_read",
      "read_ms",
      "writes_completed",
      "writes_merged",
      "sectors_written",
      "write_ms",
      "io_in_progress",
      "io_ms",
      "weighted_io_ms",
      "discards_completed",
      "discards_merged",
      "sectors_discarded",
      "discard_ms",
      "flush_completed",
      "flush_ms"
