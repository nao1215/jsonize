      },
      "minor": {
        "type": "integer"
      },
      "device": {
        "type": "string"
      },
      "reads_completed": {
        "type": "integer"
      },
      "reads_merged": {
        "type": "integer"
      },
      "sectors_read": {
        "type": "integer"
      },
      "read_ms": {
        "type": "integer"
      },
      "writes_completed": {
        "type": "integer"
      },
      "writes_merged": {
        "type": "integer"
      },
      "sectors_written": {
        "type": "integer"
      },
      "write_ms": {
        "type": "integer"
      },
      "io_in_progress": {
        "type": "integer"
      },
      "io_ms": {
        "type": "integer"
      },
      "weighted_io_ms": {
        "type": "integer"
      },
      "discards_completed": {
        "type": "integer"
      },
      "discards_merged": {
        "type": "integer"
      },
      "sectors_discarded": {
        "type": "integer"
      },
      "discard_ms": {
