{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/proc/buddyinfo.json",
  "title": "proc/buddyinfo",
  "description": "/proc/buddyinfo free blocks per zone and allocation order",
  "x-jsonize": {
