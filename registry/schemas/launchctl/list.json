{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/launchctl/list.json",
  "title": "launchctl/list",
  "description": "launchctl list loaded jobs with their process id, last exit status and label",
  "x-jsonize": {
    "definition": "launchctl/list",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pid": {
        "type": [
          "integer",
          "null"
        ]
      },
      "status": {
        "type": "integer"
      },
      "label": {
        "type": "string"
      }
    },
    "required": [
      "pid",
      "status",
      "label"
    ]
  }
}
