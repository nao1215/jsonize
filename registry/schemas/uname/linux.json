{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/uname/linux.json",
  "title": "uname/linux",
  "description": "uname -a on Linux (GNU coreutils and BusyBox)",
  "x-jsonize": {
