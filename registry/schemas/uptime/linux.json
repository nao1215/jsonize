{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/uptime/linux.json",
  "title": "uptime/linux",
  "description": "uptime on Linux (procps and BusyBox): comma separated load averages",
  "x-jsonize": {
    "definition": "uptime/linux",
    "version": 1
  },
  "type": "object",
  "properties": {
    "time": {
      "type": "string"
    },
    "uptime": {
      "type": "number"
    },
    "users": {
      "type": "integer"
    },
    "load_1m": {
      "type": "number"
    },
    "load_5m": {
      "type": "number"
    },
    "load_15m": {
      "type": "number"
    }
  },
  "required": [
    "time",
    "uptime",
    "users",
    "load_1m",
    "load_5m",
    "load_15m"
  ]
}
