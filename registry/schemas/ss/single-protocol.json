{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/ss/single-protocol.json",
  "title": "ss/single-protocol",
  "description": "ss socket table for one protocol, without the Netid column",
  "x-jsonize": {
    "definition": "ss/single-protocol",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string"
      },
      "recv_q": {
        "type": "integer"
      },
      "send_q": {
        "type": "integer"
      },
      "local_address": {
        "type": "string"
      },
      "local_port": {
        "type": "string"
      },
      "peer_address": {
        "type": "string"
      },
      "peer_port": {
        "type": "string"
      },
      "process": {
        "type": "string"
      }
    },
    "required": [
      "state",
      "recv_q",
      "send_q",
      "local_address",
      "local_port",
      "peer_address",
      "peer_port"
    ]
  }
}
