{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/ss/linux.json",
  "title": "ss/linux",
  "description": "ss socket table (-t/-u/-l/-n and combinations)",
  "x-jsonize": {
    "definition": "ss/linux",
    "version": 2
  },
  "type": "array",
