{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/swapinfo/freebsd.json",
  "title": "swapinfo/freebsd",
  "description": "FreeBSD swapinfo swap devices in the block size the heading names",
  "x-jsonize": {
    "definition": "swapinfo/freebsd",
    "version": 1
  },
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "block_size": {
          "type": "string"
        }
      },
      "required": [
        "block_size"
      ]
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "blocks": {
            "type": "integer"
          },
          "used": {
            "type": "integer"
          },
          "available": {
            "type": "integer"
          },
          "capacity_percent": {
            "type": "integer"
          }
        },
        "required": [
          "device",
          "blocks",
          "used",
          "available",
          "capacity_percent"
        ]
      }
    }
  },
  "required": [
    "header",
    "devices"
  ]
}
