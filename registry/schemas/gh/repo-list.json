{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/gh/repo-list.json",
  "title": "gh/repo-list",
  "description": "gh repo list, one repository per line when the output is not a terminal",
  "x-jsonize": {
    "definition": "gh/repo-list",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "info": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "pushed": {
        "type": "string"
      }
    },
    "required": [
      "name",
      "description",
      "info",
      "pushed"
    ]
  }
}
