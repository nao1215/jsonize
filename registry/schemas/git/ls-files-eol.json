      },
      "worktree_eol": {
        "type": "string",
        "enum": [
          "-text",
          "crlf",
          "lf",
          "mixed",
          "none"
        ]
      },
      "attributes": {
        "type": [
          "string",
          "null"
        ]
      },
      "path": {
        "type": "string"
      }
    },
    "required": [
      "index_eol",
      "worktree_eol",
      "attributes",
      "path"
    ]
  }
}
