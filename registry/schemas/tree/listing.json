{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/tree/listing.json",
  "title": "tree/listing",
  "description": "tree, a directory and what is under it",
  "x-jsonize": {
    "definition": "tree/listing",
    "version": 1
  },
  "type": "array",
  "items": {
    "$ref": "#/$defs/node"
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "link_to": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "name",
        "children"
      ]
    }
  }
}
