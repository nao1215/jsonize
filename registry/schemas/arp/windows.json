{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/arp/windows.json",
  "title": "arp/windows",
  "description": "arp -a on Windows, the ARP cache of each interface",
  "x-jsonize": {
    "definition": "arp/windows",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "interface": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "index": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "index"
        ]
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "internet_address": {
              "type": "string"
            },
            "physical_address": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "dynamic",
                "static"
              ]
            }
          },
          "required": [
            "internet_address",
            "physical_address",
            "type"
          ]
        }
      }
    },
    "required": [
      "interface",
      "entries"
    ]
  }
}
