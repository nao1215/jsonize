{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/uv/tree.json",
  "title": "uv/tree",
  "description": "uv tree, the dependency graph of a project",
  "x-jsonize": {
    "definition": "uv/tree",
    "version": 1
  },
  "type": "array",
  "items": {
    "$ref": "#/$defs/node"
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "extras": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "extra": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest": {
          "type": [
            "string",
            "null"
          ]
        },
        "deduplicated": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "name",
        "extras",
        "version",
        "extra",
        "group",
        "latest",
        "deduplicated",
        "children"
      ]
    }
  }
}
