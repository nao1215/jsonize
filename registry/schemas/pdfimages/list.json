        "type": "boolean"
      },
      "object": {
        "type": "integer"
      },
      "generation": {
        "type": "integer"
      },
      "x_ppi": {
        "type": [
          "integer",
          "null"
        ]
      },
      "y_ppi": {
        "type": [
          "integer",
          "null"
        ]
      },
      "size": {
        "type": "string"
      },
      "ratio": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "page",
      "num",
      "type",
      "width",
      "height",
      "color",
      "components",
      "bpc",
      "encoding",
      "interpolate",
      "object",
      "generation",
      "x_ppi",
      "y_ppi",
      "size",
      "ratio"
    ]
