      },
      "num": {
        "type": "integer"
      },
      "type": {
        "type": "string"
      },
      "width": {
        "type": "integer"
      },
      "height": {
        "type": "integer"
      },
      "color": {
        "type": "string"
      },
      "components": {
        "type": "integer"
      },
      "bpc": {
        "type": "integer"
      },
      "encoding": {
        "type": "string"
      },
