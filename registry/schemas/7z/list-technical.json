      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "Blocks": {
          "type": "integer"
        },
        "Headers Size": {
          "type": "integer"
        },
        "Physical Size": {
          "type": "integer"
        },
        "Solid": {
          "type": "boolean"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Accessed": {
            "type": [
              "string",
