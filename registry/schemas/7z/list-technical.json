          },
          "Block": {
            "type": [
              "integer",
              "null"
            ]
          },
          "CRC": {
            "type": [
              "string",
              "null"
            ]
          },
          "Comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "Created": {
            "type": [
              "string",
              "null"
            ]
          },
          "Encrypted": {
            "type": "boolean"
          },
          "Folder": {
            "type": "boolean"
          },
          "Method": {
            "type": [
              "string",
              "null"
            ]
          },
          "Modified": {
            "type": [
              "string",
              "null"
            ]
          },
          "Packed Size": {
            "type": [
              "integer",
              "null"
            ]
          },
          "Size": {
            "type": [
              "integer",
              "null"
            ]
          }
