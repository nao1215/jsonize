{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/iw/dev.json",
  "title": "iw/dev",
  "description": "iw dev wireless interfaces as a tree under their phy",
  "x-jsonize": {
    "definition": "iw/dev",
    "version": 1
  },
  "type": "array",
  "items": {
    "$ref": "#/$defs/node"
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "phy": {
          "type": "integer"
        },
        "interface": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "children"
      ]
    }
  }
}
