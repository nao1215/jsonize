{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/pmset/battery.json",
  "title": "pmset/battery",
  "description": "pmset -g batt power source and battery charge on macOS",
  "x-jsonize": {
    "definition": "pmset/battery",
    "version": 1
  },
  "type": "object",
  "properties": {
    "power_source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "batteries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "percent": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "remaining": {
            "type": [
              "number",
              "null"
            ]
          },
          "present": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "id",
          "percent",
          "state",
          "remaining",
          "present"
        ]
      }
    }
  },
  "required": [
    "power_source",
    "batteries"
  ]
}
