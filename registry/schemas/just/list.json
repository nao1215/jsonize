{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/just/list.json",
  "title": "just/list",
  "description": "just --list, the recipes of a justfile with their parameters and doc comments",
  "x-jsonize": {
    "definition": "just/list",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "group": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "recipes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "parameters": {
              "type": [
                "string",
                "null"
              ]
            },
            "doc": {
              "type": [
                "string",
                "null"
              ]
            },
            "aliases": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "name",
            "parameters",
            "doc",
            "aliases"
          ]
        }
      }
    },
    "required": [
      "group",
      "recipes"
    ]
  }
}
