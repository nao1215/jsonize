{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nao1215.github.io/jsonize/schemas/resolvectl/status.json",
  "title": "resolvectl/status",
  "description": "resolvectl status, per-scope resolver settings",
  "x-jsonize": {
    "definition": "resolvectl/status",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "object",
        "properties": {
          "global": {
            "type": "boolean"
          },
          "index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "global",
          "index",
          "name"
        ]
      },
      "settings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "value"
          ]
        }
      }
    },
    "required": [
      "scope",
      "settings"
    ]
  }
}
