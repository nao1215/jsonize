  "$id": "https://nao1215.github.io/jsonize/schemas/mc/ls.json",
  "title": "mc/ls",
  "description": "mc ls (MinIO client), one entry per line",
  "x-jsonize": {
    "definition": "mc/ls",
    "version": 1
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "modified": {
        "type": "string"
